---
import Button from "../components/ui/Button.astro";
import { DEFAULT_LOCALE, LOCALES, LOCALE_SETTINGS } from "../i18n/locales";
import { PAGE_SLUGS, localizedPath } from "../i18n/routes";
import { uiStrings } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const defaultStrings = uiStrings(DEFAULT_LOCALE).notFound;
const otherLocales = LOCALES.filter((locale) => locale !== DEFAULT_LOCALE);
---

<BaseLayout
  title={defaultStrings.pageTitle}
  description={defaultStrings.pageDescription}
  locale={DEFAULT_LOCALE}
  pageSlug={PAGE_SLUGS.home}
  isErrorPage
>
  <section class="mx-auto flex max-w-page flex-col items-start gap-5 px-gutter py-section">
    <h1 class="m-0 font-display text-page-title font-bold text-blue">
      {defaultStrings.title}
    </h1>
    <p class="m-0 max-w-text text-lede">{defaultStrings.text}</p>
    <Button href={localizedPath(PAGE_SLUGS.home, DEFAULT_LOCALE)}>
      {defaultStrings.homeButton}
    </Button>
    {otherLocales.map((locale) => {
      const strings = uiStrings(locale).notFound;
      return (
        <div
          lang={LOCALE_SETTINGS[locale].htmlLang}
          class="mt-8 flex flex-col items-start gap-3 border-t border-rule pt-8"
        >
          <h2 class="m-0 font-display text-item-title font-bold text-blue">
            {strings.title}
          </h2>
          <p class="m-0">{strings.text}</p>
          <Button href={localizedPath(PAGE_SLUGS.home, locale)} variant="quiet">
            {strings.homeButton}
          </Button>
        </div>
      );
    })}
  </section>
</BaseLayout>
