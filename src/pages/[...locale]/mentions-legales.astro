---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PageHead from "../../components/sections/PageHead.astro";
import SpecRow from "../../components/ui/SpecRow.astro";
import TextLink from "../../components/ui/TextLink.astro";
import Tile from "../../components/ui/Tile.astro";
import { getPageEntry } from "../../i18n/collections";
import { LOCALE_SETTINGS } from "../../i18n/locales";
import { PAGE_SLUGS, buildLocaleStaticPaths } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostalAddress } from "../../lib/address";
import {
  CONTACT_EMAIL,
  HOSTING_PROVIDER,
  LEGAL_IDENTITY,
  SITE_NAME,
  SITE_SHORT_NAME,
} from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;
const pageSlug = PAGE_SLUGS.legalNotice;
const page = await getPageEntry(pageSlug, locale);
const strings = uiStrings(locale).legalNotice;
const language = LOCALE_SETTINGS[locale].htmlLang;
const tileTitleClasses = "m-0 font-display text-item-title font-bold text-blue";
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={pageSlug}
>
  <PageHead heading={page.data.heading} lede={page.data.lede} />
  <section class="mx-auto max-w-page px-gutter pt-section-tight pb-section">
    <div class="grid gap-4 md:grid-cols-2">
      <Tile class="md:row-span-2">
        <h2 class={tileTitleClasses}>{strings.publisherTitle}</h2>
        <dl class="m-0">
          <SpecRow label={strings.name}>
            {SITE_NAME} ({SITE_SHORT_NAME})
          </SpecRow>
          <SpecRow label={strings.legalForm}>{strings.legalFormValue}</SpecRow>
          <SpecRow label={strings.headOffice}>
            {formatPostalAddress(LEGAL_IDENTITY.address, language)}
          </SpecRow>
          <SpecRow label={strings.siren}>{LEGAL_IDENTITY.siren}</SpecRow>
          <SpecRow label={strings.siret}>{LEGAL_IDENTITY.siret}</SpecRow>
          <SpecRow label={strings.rna}>{LEGAL_IDENTITY.rna}</SpecRow>
          <SpecRow label={strings.email}>
            <TextLink href={`mailto:${CONTACT_EMAIL}`} class="py-0 break-all">
              {CONTACT_EMAIL}
            </TextLink>
          </SpecRow>
        </dl>
      </Tile>
      <Tile>
        <h2 class={tileTitleClasses}>{strings.publicationTitle}</h2>
        <dl class="m-0">
          <SpecRow label={strings.publicationDirector}>
            {LEGAL_IDENTITY.publicationDirector},{" "}
            {strings.publicationDirectorRole}
          </SpecRow>
        </dl>
      </Tile>
      <Tile>
        <h2 class={tileTitleClasses}>{strings.hostingTitle}</h2>
        <dl class="m-0">
          <SpecRow label={strings.host}>{HOSTING_PROVIDER.name}</SpecRow>
          <SpecRow label={strings.hostingService}>
            <TextLink href={HOSTING_PROVIDER.url} class="py-0">
              {HOSTING_PROVIDER.service}
            </TextLink>
          </SpecRow>
          <SpecRow label={strings.hostAddress}>
            {formatPostalAddress(HOSTING_PROVIDER.address, language)}
          </SpecRow>
        </dl>
      </Tile>
      {page.data.tiles?.map((tile) => (
        <Tile>
          <h2 class={tileTitleClasses}>{tile.title}</h2>
          <p class="m-0">{tile.text}</p>
        </Tile>
      ))}
    </div>
  </section>
</BaseLayout>
