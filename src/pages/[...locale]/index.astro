---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PageHead from "../../components/sections/PageHead.astro";
import { getPageEntry } from "../../i18n/collections";
import { PAGE_SLUGS, buildLocaleStaticPaths } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;
const pageSlug = PAGE_SLUGS.home;
const page = await getPageEntry(pageSlug, locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={pageSlug}
>
  <PageHead
    heading={page.data.heading}
    lede={page.data.lede}
    headingSize="hero"
  />
</BaseLayout>
