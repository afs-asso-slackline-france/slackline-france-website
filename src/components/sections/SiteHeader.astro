---
import { Image } from "astro:assets";
import logo from "../../assets/images/logo/afs-logo.png";
import { LOCALES, LOCALE_SETTINGS, type Locale } from "../../i18n/locales";
import { buildMainNavigation } from "../../i18n/navigation";
import { PAGE_SLUGS, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import { LOGO_DENSITIES, LOGO_HEIGHT } from "../../lib/image-presets";

interface Props {
  locale: Locale;
  pageSlug: string;
}

const { locale, pageSlug } = Astro.props;
const strings = uiStrings(locale).header;
const navigationLinks = buildMainNavigation(locale, pageSlug);
const languageLinks = LOCALES.filter((other) => other !== locale).map(
  (other) => ({
    href: localizedPath(pageSlug, other),
    label: LOCALE_SETTINGS[other].shortName,
    ariaLabel: uiStrings(other).header.thisLanguageVersion,
    hreflang: LOCALE_SETTINGS[other].hreflang,
    lang: LOCALE_SETTINGS[other].htmlLang,
  }),
);
---

<header class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 px-gutter py-3.5">
  <a href={localizedPath(PAGE_SLUGS.home, locale)} class="block">
    <Image
      src={logo}
      alt={strings.homeLinkLabel}
      height={LOGO_HEIGHT}
      densities={LOGO_DENSITIES}
      loading="eager"
      class="block h-11 w-auto mix-blend-multiply"
    />
  </a>
  <nav aria-label={strings.mainNavigationLabel}>
    <ul class="m-0 flex list-none flex-wrap items-center gap-x-4 gap-y-0.5 p-0 font-semibold text-blue md:gap-x-8">
      {navigationLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="menu-link px-0.5 pt-1.5 pb-3.5 md:pt-3 md:pb-4.5"
            aria-current={link.isCurrent ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      {languageLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="menu-link px-0.5 pt-1.5 pb-3.5 md:pt-3 md:pb-4.5"
            hreflang={link.hreflang}
            lang={link.lang}
            aria-label={link.ariaLabel}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .menu-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }

  .menu-link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: var(--arc-offset);
    height: var(--arc-height);
    border-bottom: var(--arc-thickness) solid var(--color-raspberry);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    opacity: 0;
    transform: scaleY(var(--arc-hidden-scale));
    transform-origin: top;
    transition:
      opacity var(--motion-fast),
      transform var(--motion-base);
  }

  .menu-link:hover::after,
  .menu-link[aria-current="page"]::after {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-link::after {
      transition: none;
    }
  }
</style>
