---
import { SITE_INDEXABLE } from "astro:env/server";
import "../styles/global.css";
import { LOCALE_SETTINGS, type Locale } from "../i18n/locales";
import { buildAlternateLinks, localizedPath } from "../i18n/routes";
import { uiStrings } from "../i18n/ui";
import { absoluteUrl, robotsDirective } from "../lib/seo";
import { SITE_NAME } from "../lib/site";
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "../lib/structured-data";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pageSlug: string;
  isErrorPage?: boolean;
}

const {
  title,
  description,
  locale,
  pageSlug,
  isErrorPage = false,
} = Astro.props;
const localeSettings = LOCALE_SETTINGS[locale];
const canonicalUrl = absoluteUrl(localizedPath(pageSlug, locale));
const alternateLinks = isErrorPage ? [] : buildAlternateLinks(pageSlug);
const structuredData = [buildWebSiteSchema(), buildOrganizationSchema()];
const strings = uiStrings(locale);
const isIndexable = SITE_INDEXABLE && !isErrorPage;
---

<!doctype html>
<html lang={localeSettings.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective(isIndexable)} />
    {!isErrorPage && <link rel="canonical" href={canonicalUrl} />}
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={localeSettings.openGraphLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      {strings.accessibility.skipToContent}
    </a>
    <main id="main-content" class="flex-1">
      <slot />
    </main>
  </body>
</html>
